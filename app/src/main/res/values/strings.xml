    <string name="onboarding_welcome_title">হিসাবডেস্কে স্বাগতম</string>
    <string name="onboarding_welcome_body">আপনার আয়-ব্যয়, ধার-দেনা, সঞ্চয় ও ঋণের পূর্ণ হিসাব রাখুন এক জায়গায়। সব তথ্য থাকে আপনার নিজের ফোনে — ইন্টারনেট বা ক্লাউড অ্যাকাউন্টের প্রয়োজন নেই।</string>
    <string name="onboarding_privacy_title">গোপনীয়তা ও নিরাপত্তা</string>
    <string name="onboarding_privacy_body">হিসাবডেস্ক অফলাইনে কাজ করে। আপনার আর্থিক তথ্য আপনার ডিভাইস ছাড়া কোথাও পাঠানো হয় না। অ্যাপ খোলার জন্য একটি নিরাপদ পিন তৈরি করুন।</string>
    <string name="onboarding_pin_title">পিন তৈরি করুন</string>
    <string name="onboarding_pin_body">৪ থেকে ৬ সংখ্যার একটি পিন দিন। এই পিন দিয়েই প্রতিবার হিসাবডেস্ক খুলবেন।</string>
    <string name="onboarding_pin_confirm_title">পিন নিশ্চিত করুন</string>
    <string name="onboarding_pin_confirm_body">নিশ্চিত করতে আবার একই পিন লিখুন।</string>
    <string name="onboarding_account_title">প্রথম অ্যাকাউন্ট (ঐচ্ছিক)</string>
    <string name="onboarding_account_body">যে অ্যাকাউন্ট বা মানিব্যাগে টাকা রাখেন তা যোগ করুন। প্রারম্ভিক ব্যালেন্স চাইলে সেটি শুরুর ব্যালেন্স হিসেবে সংরক্ষিত হবে — কোনো কৃত্রিম আয় তৈরি হবে না।</string>
    <string name="onboarding_categories_title">ক্যাটাগরি (ঐচ্ছিক)</string>
    <string name="onboarding_categories_body">প্রস্তাবিত ক্যাটাগরিগুলো চাইলে ব্যবহার করুন বা নিজের ক্যাটাগরি তৈরি করুন। এগুলো পরে যেকোনো সময় সম্পাদনা করা যাবে।</string>
    <string name="onboarding_done_title">সব তৈরি!</string>
    <string name="onboarding_done_body">আপনার হিসাবডেস্ক প্রস্তুত। এখন থেকে আয়-ব্যয় ও সব আর্থিক হিসাব রাখা শুরু করুন।</string>
    <string name="onboarding_goto_dashboard">ড্যাশবোর্ডে যান</string>

